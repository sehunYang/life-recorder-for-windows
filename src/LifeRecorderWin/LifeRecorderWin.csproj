<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041: Windows.Media.Control(미디어 세션)을 쓰기 위해. Windows 10 2004 이상 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LifeRecorder</AssemblyName>
    <RootNamespace>LifeRecorderWin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 트레이 상주 앱이라 콘솔 창이 뜨면 안 된다. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- ffmpeg 을 넣으면 300MB 가까이 된다. 압축하면 절반 아래로 떨어진다. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!--
    배포판은 ffmpeg 을 exe 안에 넣어 파일 하나로 만든다. 처음 실행할 때 꺼내 쓴다
    (Capture/Ffmpeg.cs). 개발 빌드는 넣지 않는다 — 139MB 를 어셈블리에 박으면 빌드가 느려지고,
    tools\ffmpeg\ 를 그대로 쓰면 되기 때문이다.

      개발:   dotnet build
      배포:   dotnet publish -c Release -p:PublishSingleFile=true -p:EmbedFfmpeg=true
  -->
  <PropertyGroup>
    <EmbedFfmpeg Condition="'$(EmbedFfmpeg)' == ''">false</EmbedFfmpeg>
    <FfmpegPath>$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\ffmpeg.exe</FfmpegPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(EmbedFfmpeg)' == 'true'">
    <EmbeddedResource Include="$(FfmpegPath)" LogicalName="ffmpeg.exe" />
  </ItemGroup>

  <Target Name="CheckFfmpegPresent" BeforeTargets="BeforeBuild" Condition="'$(EmbedFfmpeg)' == 'true'">
    <Error Condition="!Exists('$(FfmpegPath)')"
           Text="ffmpeg 을 넣으려면 먼저 scripts\get-ffmpeg.ps1 을 실행하세요. 찾은 경로: $(FfmpegPath)" />
  </Target>

  <ItemGroup>
    <!-- 리프레시 토큰을 사용자 계정 키로 암호화해 둔다 (DPAPI). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!--
      UIAutomationClient(브라우저 주소창·문서 스크롤 읽기, Capture/BrowserProbe.cs)는 WPF 묶음에 있다.
      UseWPF 를 켜면 암시적 using 이 바뀌어 System.IO 등이 사라지므로, 전체 데스크톱 프레임워크를 직접 참조한다.
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

</Project>
